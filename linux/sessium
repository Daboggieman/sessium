# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------

def say(msg: str) -> None:
    if not QUIET:
        print(msg)


def ok(msg: str) -> None:
    if not QUIET:
        print(f"[OK] {msg}")


def warn(msg: str) -> None:
    print(f"[!]  {msg}", file=sys.stderr)


def fail(msg: str) -> None:
    print(f"[X]  {msg}", file=sys.stderr)


def debug(msg: str) -> None:
    if DEBUG:
        print(f"[dbg] {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# paths and configuration
# ---------------------------------------------------------------------------

def claude_dir() -> Path:
    """Claude Code's data root (SESSIUM_CLAUDE_DIR overrides, for tests)."""
    return Path(os.environ.get("SESSIUM_CLAUDE_DIR", str(Path.home() / ".claude")))


def config_path() -> Path:
    env = os.environ.get("SESSIUM_CONFIG")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    return Path(xdg) / "sessium" / "config.json"


def state_path() -> Path:
    env = os.environ.get("SESSIUM_STATE")
    if env:
        return Path(env)
    xdg = os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))
    return Path(xdg) / "sessium" / "state.json"


def rclone_bin() -> str:
    return os.environ.get("SESSIUM_RCLONE_BIN", "rclone")


def munge(project_path: str) -> str:
    """Claude Code stores each project's sessions under its absolute path
    with every '/' replaced by '-' (leading slash included)."""
    return project_path.replace("/", "-")


def load_config() -> dict:
    """Effective config. Precedence: config.json > legacy sessium/config.sh > defaults."""
    cfg = {"rclone_remote": "gdrive", "drive_folder": "claude-backup",
           "seeker_url": "", "seeker_token": ""}
    path = config_path()
    if path.is_file():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            for key in cfg:
                if data.get(key):
                    cfg[key] = data[key]
            return cfg
        except (json.JSONDecodeError, OSError) as exc:
            warn(f"unreadable config {path}: {exc}")
    legacy = Path.home() / "sessium" / "config.sh"
    if legacy.is_file():
        try:
            text = legacy.read_text(encoding="utf-8")
            match = re.search(r'^DRIVE_REMOTE="([^"]*)"', text, re.MULTILINE)
            if match:
                cfg["rclone_remote"] = match.group(1)
            match = re.search(r'^DRIVE_DIR="([^"]*)"', text, re.MULTILINE)
            if match:
                cfg["drive_folder"] = match.group(1)
        except OSError as exc:
            warn(f"unreadable legacy config {legacy}: {exc}")
    return cfg


def drive_url(cfg: dict, sub: str = "") -> str:
    base = f"{cfg['rclone_remote']}:{cfg['drive_folder']}"
    return f"{base}/{sub}" if sub else base


# ---------------------------------------------------------------------------
# the ledger — sessium's ".git" state (schema v1, see SPEC.md)
# ---------------------------------------------------------------------------

LEDGER_VERSION = 1


def ledger_key(project: str, sid: str) -> str:
    return f"{project}/{sid}"


def new_ledger() -> dict:
    return {"version": LEDGER_VERSION, "sessions": {}}


def load_ledger() -> dict:
    path = state_path()
    if not path.is_file():
        return new_ledger()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or not isinstance(data.get("sessions"), dict):
            raise ValueError("not a sessium ledger")
        return data
    except (json.JSONDecodeError, OSError, ValueError) as exc:
        warn(f"ledger {path} unreadable ({exc}) — starting fresh; matching "
             "sessions will be re-recorded via the bootstrap rule")
        return new_ledger()


def save_ledger(ledger: dict) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    ledger["version"] = LEDGER_VERSION
    path.write_text(
        json.dumps(ledger, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def record_sync(ledger: dict, project: str, sid: str,
                local_md5: str, remote_md5: str) -> None:
    ledger.setdefault("sessions", {})[ledger_key(project, sid)] = {
        "project": project,
        "id": sid,
        "local_md5": local_md5,
        "remote_md5": remote_md5,
        "last_synced": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }


def record_bootstrap(ledger: dict, rows: list) -> int:
    """PLAN §2 bootstrap rule: matching copies with no ledger record are
    recorded as in-sync — no prompts, no day-one mass conflict. Only the
    write commands (push/pull/sync) record; status stays read-only."""
    n = 0
    for row in rows:
        if row["state"] == "in-sync" and not row["entry"]:
            record_sync(ledger, row["project"], row["id"],
                        row["local"]["md5"], row["remote"]["md5"])
            n += 1
    return n


# ---------------------------------------------------------------------------
# transfer lock — one mutating transfer at a time (cron vs manual collision)
# ---------------------------------------------------------------------------

LOCK_STALE_SECONDS = 600


class LockBusy(Exception):
    pass


@contextmanager
def transfer_lock(dry_run: bool = False):
    """Serialize push/pull/sync per machine with a lock file next to the
    ledger. --dry-run mutates nothing and never locks. A lock older than
    LOCK_STALE_SECONDS is treated as a crashed run and broken with a
    warning; a fresh one is a hard error."""
    if dry_run:
        yield
        return
    lock = state_path().parent / "sync.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    while True:
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            break
        except FileExistsError:
            try:
                age = time.time() - lock.stat().st_mtime
            except OSError:
                continue                       # vanished between the calls
            if age > LOCK_STALE_SECONDS:
                warn(f"breaking stale lock {lock} ({age / 60:.0f} min old — "
                     "likely a crashed run)")
                try:
                    lock.unlink()
                except OSError:
                    pass
                continue
            raise LockBusy(
                f"another sessium transfer holds {lock} — wait for it, or "
                "delete the file if that run is dead")
    try:
        os.write(fd, f"pid {os.getpid()} started "
                     f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n".encode())
        os.close(fd)
        yield
    finally:
        try:
            lock.unlink()
        except OSError:
            pass


# ---------------------------------------------------------------------------
# rclone wrapper — the only door to the outside world
# ---------------------------------------------------------------------------

class RcloneError(Exception):
    pass


def rclone(*args: str, timeout: int = 120, check: bool = True, to_file=None):
    """Run rclone. With to_file=<path>, stdout streams into that file (used
    for `rclone cat` of big transcripts) instead of being captured."""
    cmd = [rclone_bin(), *args]
    debug(" ".join(cmd))
    try:
        if to_file:
            with open(to_file, "wb") as handle:
                proc = subprocess.run(cmd, stdout=handle,
                                      stderr=subprocess.PIPE, timeout=timeout)
        else:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError as exc:
        raise RcloneError(
            f"rclone not found (tried: {rclone_bin()!r}) — install it, or point "
            f"SESSIUM_RCLONE_BIN at the binary"
        ) from exc
    except subprocess.TimeoutExpired as exc:
        raise RcloneError(f"rclone timed out after {timeout}s: {' '.join(args[:2])}") from exc
    if check and proc.returncode != 0:
        detail = proc.stderr or proc.stdout or ""
        if isinstance(detail, bytes):
            detail = detail.decode("utf-8", "replace")
        lines = detail.strip().splitlines()
        tail = lines[-1][:200] if lines else "(no output)"
        raise RcloneError(f"rclone {' '.join(args[:2])} failed (rc={proc.returncode}): {tail}")
    return proc


# ---------------------------------------------------------------------------
# hashing and time helpers
# ---------------------------------------------------------------------------

def md5_of(path: Path, chunk: int = 1 << 20) -> str:
    digest = hashlib.md5()
    with open(path, "rb") as handle:
        while True:
            block = handle.read(chunk)
            if not block:
                break
            digest.update(block)
    return digest.hexdigest()


def parse_rclone_time(value: str):
    """rclone ModTime is RFC3339 with nanoseconds; trim the fraction to
    microseconds (keeping any timezone offset) so datetime.fromisoformat
    accepts it on every Python 3 we support. Returns an aware UTC datetime,
    or None when unparseable."""
    if not value:
        return None
    value = re.sub(r"\.(\d{6})\d+", r".\1", value)
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(
            UTC
        )
    except ValueError:
        return None


def mtime_of(session: dict):
    """A session's mtime as an aware UTC datetime — local copies store an
    epoch float, remote copies a datetime (or None)."""
    value = session.get("mtime")
    if value is None or value == "":
        return None
    if isinstance(value, datetime):
        return value
    try:
        return datetime.fromtimestamp(value, tz=UTC)
    except (OSError, OverflowError, ValueError):
        return None


def fmt_time(value) -> str:
    """Display form for an epoch float, a datetime, or nothing."""
    if value is None or value == "":
        return "-"
    if isinstance(value, datetime):
        return value.strftime("%Y-%m-%d %H:%M")
    return fmt_local_time(value)


# ---------------------------------------------------------------------------
# discovery — local side
# ---------------------------------------------------------------------------

def local_sessions() -> dict:
    """munged project name -> sorted list of session dicts (id, path, size, mtime, md5)."""
    root = claude_dir() / "projects"
    result = {}
    if not root.is_dir():
        return result
    for project in sorted(root.iterdir()):
        if not project.is_dir():
            continue
        sessions = []
        for jsonl in sorted(project.glob("*.jsonl")):
            try:
                stat = jsonl.stat()
            except OSError:
                continue
            sessions.append({
                "id": jsonl.stem,
                "path": str(jsonl),
                "size": stat.st_size,
                "mtime": stat.st_mtime,
                "md5": md5_of(jsonl),
            })
        result[project.name] = sessions
    return result


def extract_text(content) -> str:
    """User message content is either a plain string or a list of blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                parts.append(str(block.get("text", "")))
        return " ".join(parts)
    return ""


def session_title(path: Path, max_lines: int = 200) -> str:
    """Best-effort title: the first real user message in the transcript.
    Skips meta entries and slash-command wrappers; returns '' if none found."""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for index, line in enumerate(handle):
                if index >= max_lines:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") != "user" or entry.get("isMeta"):
                    continue
                text = extract_text((entry.get("message") or {}).get("content")).strip()
                if not text:
                    continue
                if text.startswith(("<command-", "<local-command", "<ide_")):
                    continue
                return " ".join(text.split())[:70]
    except OSError:
        pass
    return ""


# ---------------------------------------------------------------------------
# discovery — remote side
# ---------------------------------------------------------------------------

def remote_sessions(cfg: dict) -> dict:
    """munged project name -> list of session dicts, read straight off Drive."""
    try:
        proc = rclone("lsjson", "--recursive", "--hash", drive_url(cfg, "projects"))
    except RcloneError as exc:
        # a fresh remote has no projects/ folder yet — that is "empty", not
        # "unreachable" (push creates the folder chain on its first upload)
        if "directory not found" in str(exc).lower():
            return {}
        raise
    entries = json.loads(proc.stdout or "[]")
    result = {}
    for entry in entries:
        if entry.get("IsDir"):
            continue
        path = entry.get("Path", "")
        if not path.endswith(".jsonl") or "/" not in path:
            continue
        project, filename = path.split("/", 1)
        if "/" in filename:
            continue  # transcripts live at the top level of each project
        result.setdefault(project, []).append({
            "id": filename[:-len(".jsonl")],
            "size": entry.get("Size", 0),
            "mtime": parse_rclone_time(entry.get("ModTime", "")),
            "md5": (entry.get("Hashes") or {}).get("MD5", ""),
        })
    for sessions in result.values():
        sessions.sort(key=lambda s: s["id"])
    return result


def classify_row(project: str, sid: str, local, remote, entry) -> dict:
    """Classify one (project, session) against its ledger record (PLAN §2)."""
    if entry:
        l_match = bool(local) and entry.get("local_md5") == local["md5"]
        r_match = bool(remote) and entry.get("remote_md5") == remote["md5"]
        if local and remote:
            if l_match and r_match:
                state = "in-sync"
            elif l_match:
                state = "pull"       # only the remote copy moved
            elif r_match:
                state = "push"       # only the local copy moved
            else:
                state = "conflict"   # both sides moved
        elif local:
            state = "new-here"       # remote copy vanished → re-upload
        else:
            state = "new-there"      # local copy vanished → re-download
    elif local and remote:
        # no record: bootstrap rule says matching copies are in-sync, and
        # genuinely divergent copies are a first-sight conflict
        state = "in-sync" if (local["md5"] and local["md5"] == remote["md5"]) \
            else "conflict"
    else:
        state = "new-here" if local else "new-there"
    return {
        "project": project,
        "id": sid,
        "state": state,
        "local": local,
        "remote": remote,
        "entry": entry,
    }


def classify_ledger(local_map: dict, remote_map: dict, ledger: dict) -> list:
    """One row per (project, session) present on either side, classified
    against the ledger. States: in-sync / push / pull / conflict /
    new-here / new-there."""
    sessions = ledger.get("sessions", {})
    rows = []
    for project in sorted(set(local_map) | set(remote_map)):
        here = {s["id"]: s for s in local_map.get(project, [])}
        there = {s["id"]: s for s in remote_map.get(project, [])}
        for sid in sorted(set(here) | set(there)):
            entry = sessions.get(ledger_key(project, sid))
            rows.append(classify_row(project, sid, here.get(sid), there.get(sid), entry))
    return rows


# ---------------------------------------------------------------------------
# transfers — the only code that moves session bytes
# ---------------------------------------------------------------------------

def find_sessions(prefix: str, local_map: dict, remote_map: dict) -> list:
    """Rows whose session id starts with prefix. Callers turn zero/multiple
    matches into their own error."""
    rows = classify_ledger(local_map, remote_map, load_ledger())
    return [r for r in rows if r["id"].startswith(prefix)]


def find_one_session(args_session: str, local_map: dict, remote_map: dict):
    """resolve/diff share this: exactly one match or a printed error."""
    rows = find_sessions(args_session, local_map, remote_map)
    if not rows:
        fail(f"no session id starts with {args_session!r}")
        return None
    if len(rows) > 1:
        fail(f"ambiguous id prefix {args_session!r} — matches:")
        for row in rows:
            say(f"  {row['project']}/{row['id']}")
        return None
    return rows[0]


def local_session_path(project: str, sid: str) -> Path:
    return claude_dir() / "projects" / project / f"{sid}.jsonl"


# ---------------------------------------------------------------------------
# transcript inspection (diff)
# ---------------------------------------------------------------------------

def inspect_transcript(path: Path) -> dict:
    """Message count + last user/assistant text, streaming (transcripts can
    be tens of MB). Meta entries and tool wrappers don't count."""
    count = 0
    last = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") not in ("user", "assistant") or entry.get("isMeta"):
                    continue
                text = extract_text((entry.get("message") or {}).get("content")).strip()
                if not text:
                    continue
                count += 1
                last = text
    except OSError:
        pass
    return {"messages": count, "last": " ".join(last.split())[:70]}


def session_cwd(path: Path, max_lines: int = 50) -> str:
    """The repo path recorded in the transcript's entries (Claude Code stamps
    a `cwd` on most lines). This is how `open` maps a session back to its
    repo without having to reverse the lossy munging."""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for index, line in enumerate(handle):
                if index >= max_lines:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                cwd = entry.get("cwd")
                if isinstance(cwd, str) and cwd:
                    return cwd
    except OSError:
        pass
    return ""


def fetch_remote_transcript(cfg: dict, project: str, sid: str) -> Path:
    """Download a transcript for inspection; caller removes the temp file."""
    fd, name = tempfile.mkstemp(prefix=f"sessium-{sid[:8]}-")
    os.close(fd)
    path = Path(name)
    rclone("cat", drive_url(cfg, f"projects/{project}/{sid}.jsonl"),
           timeout=300, to_file=str(path))
    return path


def upload_session(cfg: dict, project: str, sid: str, local_path: str) -> None:
    rclone("copyto", local_path, drive_url(cfg, f"projects/{project}/{sid}.jsonl"),
           timeout=300)


def download_session(cfg: dict, project: str, sid: str, local_path: str) -> None:
    Path(local_path).parent.mkdir(parents=True, exist_ok=True)
    rclone("copyto", drive_url(cfg, f"projects/{project}/{sid}.jsonl"), local_path,
           timeout=300)


def revert_path(project: str, sid: str) -> Path:
    """A not-yet-taken name in the project's revert/ folder. Revert copies
    live under <claude-dir>/projects/<project>/revert/ so they never pollute
    the session listing (which only globs top-level *.jsonl)."""
    d = claude_dir() / "projects" / project / "revert"
    d.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dst = d / f"{sid}.revert-{stamp}.jsonl"
    n = 0
    while dst.exists():                      # two conflicts within one second
        n += 1
        dst = d / f"{sid}.revert-{stamp}-{n}.jsonl"
    return dst


def save_local_revert(project: str, sid: str, src: Path) -> Path:
    """Preserve a losing LOCAL copy: move it into revert/."""
    dst = revert_path(project, sid)
    src.replace(dst)
    return dst


def save_remote_revert(cfg: dict, project: str, sid: str) -> Path:
    """Preserve a losing REMOTE copy: download it into revert/ before the
    upload overwrites it on Drive."""
    dst = revert_path(project, sid)
    rclone("copyto", drive_url(cfg, f"projects/{project}/{sid}.jsonl"), str(dst),
           timeout=300)
    return dst


# ---------------------------------------------------------------------------
# history — content-addressed snapshots of every replaced copy (SPEC §10)
# ---------------------------------------------------------------------------

def history_dir(project: str, sid: str) -> Path:
    return claude_dir() / "projects" / project / sid / "history"


def snapshot_history(project: str, sid: str, src: Path) -> Path | None:
    """Keep the bytes of a copy that is about to be (or was just) replaced,
    content-addressed: <seq>-<md5[:8]>.jsonl. Identical content lands under
    an identical name — the second save is a free dedup no-op. Never touches
    the ledger. Returns the new snapshot, or None when it already existed."""
    try:
        digest = md5_of(src)
    except OSError:
        return None
    hdir = history_dir(project, sid)
    hdir.mkdir(parents=True, exist_ok=True)
    suffix = f"-{digest[:8]}.jsonl"
    for existing in hdir.glob("*.jsonl"):
        if existing.name.endswith(suffix):
            return None                    # these bytes are already kept
    seq = len(list(hdir.glob("*.jsonl"))) + 1
    dst = hdir / f"{seq:04d}-{digest[:8]}.jsonl"
    shutil.copy2(src, dst)                 # copy: the source lives in revert/
    return dst


# ---------------------------------------------------------------------------
# formatting
# ---------------------------------------------------------------------------

def short_id(session_id: str, keep: int = 8) -> str:
    return session_id[:keep]


def human_size(size: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.0f}{unit}" if unit == "B" else f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}GB"


def fmt_local_time(mtime: float) -> str:
    if not mtime:
        return "-"
    return datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")


def fmt_state(state: str) -> str:
    return {
        "in-sync": "in-sync",
        "push": "push",
        "pull": "pull",
        "new-here": "new-here",
        "new-there": "new-there",
        "conflict": "CONFLICT",
    }.get(state, state)


def iso_time(value) -> str | None:
    """JSON-safe UTC timestamp from an epoch float, a datetime, or nothing
    (SPEC §9 --json rows always carry mtimes in this form)."""
    if value is None or value == "":
        return None
    if isinstance(value, datetime):
        return value.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        return datetime.fromtimestamp(
            value, tz=UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (OSError, OverflowError, ValueError):
        return None


def emit_json(data) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_list(args) -> int:
    """Inventory of local sessions (no Drive access)."""
    local_map = filter_map(local_sessions(), args.project)
    if args.project and not local_map:
        fail(f"no local project folder named {args.project!r}")
        return 1
    if getattr(args, "json", False):
        rows = []
        for project, sessions in local_map.items():
            for s in sessions:
                row = {
                    "project": project,
                    "id": s["id"],
                    "path": s["path"],
                    "size": s["size"],
                    "mtime": iso_time(s["mtime"]),
                }
                if args.titles:
                    row["title"] = session_title(Path(s["path"]))
                rows.append(row)
        rows.sort(key=lambda r: r["mtime"] or "", reverse=True)
        emit_json(rows)
        return 0
    total = 0
    for project, sessions in local_map.items():
        if not sessions:
            continue
        say(f"\n{project}  ({len(sessions)} session{'s' if len(sessions) != 1 else ''})")
        for s in sorted(sessions, key=lambda x: x["mtime"], reverse=True):
            total += 1
            title = session_title(Path(s["path"])) if args.titles else ""
            title_col = f"  {title}" if title else ""
            say(f"  {fmt_local_time(s['mtime'])}  {human_size(s['size']):>8}  "
                f"{short_id(s['id'])}{title_col}")
    if total == 0:
        say("No local sessions found.")
    return 0


def filter_map(session_map: dict, project) -> dict:
    """--project filter: keep only that munged project folder."""
    if not project:
        return session_map
    return {k: v for k, v in session_map.items() if k == project}


def cmd_status(args) -> int:
    """Compare local sessions against Drive, classified by the ledger."""
    cfg = load_config()
    local_map = filter_map(local_sessions(), args.project)
    reachable = True
    try:
        remote_map = filter_map(remote_sessions(cfg), args.project)
    except RcloneError as exc:
        warn(f"cannot reach Drive right now: {exc}")
        warn("showing local-only view — run 'sessium check' for details")
        remote_map = {}
        reachable = False

    rows = classify_ledger(local_map, remote_map, load_ledger())
    counts = {}
    for row in rows:
        counts[row["state"]] = counts.get(row["state"], 0) + 1

    if getattr(args, "json", False):
        emit_json({
            "remote": drive_url(cfg),
            "reachable": reachable,
            "projects": len(set(local_map) | set(remote_map)),
            "sessions": len(rows),
            "counts": counts,
            "rows": [{
                "project": r["project"],
                "id": r["id"],
                "state": r["state"],
                "local": None if not r["local"] else {
                    "size": r["local"]["size"],
                    "md5": r["local"]["md5"],
                    "mtime": iso_time(r["local"]["mtime"]),
                },
                "remote": None if not r["remote"] else {
                    "size": r["remote"]["size"],
                    "md5": r["remote"]["md5"],
                    "mtime": iso_time(r["remote"]["mtime"]),
                },
                "last_synced": (r["entry"] or {}).get("last_synced"),
            } for r in sorted(rows, key=lambda r: (r["project"], r["id"]))],
        })
        return 0

    say(f"remote: {drive_url(cfg)}")
    summary = "   ".join(f"{fmt_state(k)}: {v}" for k, v in sorted(counts.items()))
    say(f"projects: {len(set(local_map) | set(remote_map))}   "
        f"sessions: {len(rows)}" + (f"   {summary}" if summary else ""))
    if not rows:
        say("Nothing to report — no sessions on either side (filtered).")
        return 0

    say("")
    header = f"  {'STATE':<12}{'ID':<10}{'MODIFIED':<18}{'SIZE':>9}  PROJECT"
    say(header)
    for row in sorted(rows, key=lambda r: (r["project"], r["state"], r["id"])):
        source = row["local"] or row["remote"]
        modified = fmt_time(source.get("mtime"))
        size = human_size(source.get("size", 0))
        say(f"  {fmt_state(row['state']):<12}{short_id(row['id']):<10}"
            f"{modified:<18}{size:>9}  {row['project']}")
    if counts.get("conflict"):
        say("\n[!] CONFLICT sessions: both copies changed since the last sync. "
            "Run 'sessium sync' to resolve (newest wins unless you answer the "
            "prompt; the losing copy is kept in revert/).")
    return 0


def cmd_check(args) -> int:
    """Read-only self-test: rclone present, config sane, Drive reachable,
    local repo present. Writes nothing (the round-trip write test lives in
    setup-ubuntu.sh / setup-windows.ps1)."""
    # 1. rclone present?
    try:
        proc = rclone("version", timeout=15)
        version = proc.stdout.splitlines()[0] if proc.stdout else "unknown"
        ok(f"rclone: {version}")
    except RcloneError as exc:
        fail(f"rclone: {exc}")
        return 1

    # 2. config
    cfg = load_config()
    from_config_json = config_path().is_file()
    source = "config.json" if from_config_json else "sessium/config.sh (legacy)"
    ok(f"config from {source}: remote={cfg['rclone_remote']} folder={cfg['drive_folder']}")

    # 3. remote reachable?
    try:
        rclone("lsd", f"{cfg['rclone_remote']}:", timeout=30)
        ok(f"remote '{cfg['rclone_remote']}' reachable")
    except RcloneError as exc:
        fail(str(exc))
        return 1

    # 4. backup folder present? (created automatically on first push/sync)
    try:
        rclone("lsf", drive_url(cfg), timeout=30)
        ok(f"backup folder '{cfg['drive_folder']}' found on Drive")
    except RcloneError:
        warn(f"backup folder '{cfg['drive_folder']}' not on Drive yet — "
             "it will be created on first push/sync")

    # 5. local repo
    projects = local_sessions()
    session_count = sum(len(v) for v in projects.values())
    ok(f"local repo: {len(projects)} project(s), {session_count} session(s) "
       f"under {claude_dir() / 'projects'}")

    # 6. ledger
    if state_path().is_file():
        ok(f"ledger: {state_path()}")
    else:
        say(f"     ledger not created yet — push/pull/sync will create it "
            f"at {state_path()}")

    if not getattr(args, "full", False):
        return 0
    return deep_check(cfg, projects)


def pick_sample(items: list, count: int) -> list:
    """Deterministic, evenly spread sample of a sorted list (up to count)."""
    if len(items) <= count:
        return list(items)
    step = len(items) / count
    return [items[min(len(items) - 1, int(i * step))] for i in range(count)]


def deep_check(cfg: dict, projects: dict) -> int:
    """The --full half of check: audit the ledger against both sides and
    spot-verify a sample of in-sync sessions (local bytes vs Drive hash).
    Read-only. Orphans and dead ledger entries are informational (sessium
    never deletes); an md5 spot-check mismatch is a real failure."""
    say("")
    say("deep check (--full):")
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        fail(f"deep check: cannot list Drive: {exc}")
        return 1

    local_keys, local_md5s = set(), {}
    for project, sessions in projects.items():
        for sess in sessions:
            key = f"{project}/{sess['id']}"
            local_keys.add(key)
            local_md5s[key] = sess["md5"]
    remote_keys, remote_md5s = set(), {}
    for project, sessions in remote_map.items():
        for sess in sessions:
            key = f"{project}/{sess['id']}"
            remote_keys.add(key)
            remote_md5s[key] = sess["md5"]
    live = local_keys | remote_keys

    ledger = load_ledger().get("sessions", {})

    # 7. dead ledger entries — recorded, but the file is gone from both sides
    dead = sorted(set(ledger) - live)
    if dead:
        warn(f"dead ledger entries: {len(dead)} (harmless; they classify as "
             "new-here/new-there until pruned by hand)")
        for key in dead[:10]:
            say(f"       - {key}")
        if len(dead) > 10:
            say(f"       … and {len(dead) - 10} more")
    else:
        ok("ledger: no dead entries")

    # 8. orphans — on Drive but never recorded here (normal: other machines)
    orphans = sorted((remote_keys - local_keys) - set(ledger))
    if orphans:
        say(f"     orphans on Drive (never synced from this machine): "
            f"{len(orphans)} — expected for other machines' sessions")
        for key in orphans[:10]:
            orphan_project, orphan_sid = key.rsplit("/", 1)
            say(f"       - {orphan_project}/{short_id(orphan_sid)}")
        if len(orphans) > 10:
            say(f"       … and {len(orphans) - 10} more")
    else:
        ok("no orphans on Drive")

    # 9. spot-check: live local md5 vs live Drive md5 on in-sync sessions
    candidates = sorted(
        key for key in local_keys & remote_keys
        if ledger.get(key, {}).get("local_md5") == ledger.get(key, {}).get("remote_md5")
        and remote_md5s.get(key))
    sample = pick_sample(candidates, 10)
    mismatches = 0
    for key in sample:
        project, sid = key.rsplit("/", 1)
        if local_md5s[key] == remote_md5s[key]:
            ok(f"spot-check {project}/{short_id(sid)}: md5 matches on both sides")
        else:
            fail(f"spot-check {key}: local md5 {local_md5s[key]} "
                 f"!= Drive md5 {remote_md5s[key]} — re-push or re-pull this session")
            mismatches += 1
    if not sample:
        say("     nothing to spot-check yet (no sessions on both sides)")
    elif not mismatches:
        ok(f"spot-check: {len(sample)} session(s) verified")

    return 1 if mismatches else 0


def transfer_summary(pushed: int, pulled: int, conflicts_skipped: int,
                     in_sync: int, failures: int) -> str:
    parts = [f"pushed: {pushed}", f"pulled: {pulled}"]
    if conflicts_skipped:
        parts.append(f"conflicts skipped: {conflicts_skipped}")
    parts.append(f"in-sync: {in_sync}")
    if failures:
        parts.append(f"FAILED: {failures}")
    return "   ".join(parts)


def cmd_push(args) -> int:
    """Upload new/changed sessions to Drive. Never overwrites a remote copy
    that changed on its own — conflicts are skipped (use sync/resolve)."""
    cfg = load_config()
    with transfer_lock(args.dry_run):
        local_map = filter_map(local_sessions(), args.project)
        try:
            remote_map = filter_map(remote_sessions(cfg), args.project)
        except RcloneError as exc:
            fail(f"cannot reach Drive: {exc}")
            return 1
        ledger = load_ledger()
        rows = classify_ledger(local_map, remote_map, ledger)

        pushed = conflicts = failures = 0
        ledger_dirty = False
        for row in rows:
            label = f"{row['project']}/{short_id(row['id'])}"
            if row["state"] == "conflict":
                conflicts += 1
                warn(f"skipped CONFLICT {label} — 'sessium sync' or 'sessium "
                     "resolve' decides it")
                continue
            if row["state"] not in ("push", "new-here"):
                continue
            if args.dry_run:
                say(f"would push {label} ({human_size(row['local']['size'])})")
                pushed += 1
                continue
            try:
                upload_session(cfg, row["project"], row["id"],
                               row["local"]["path"])
                record_sync(ledger, row["project"], row["id"],
                            row["local"]["md5"], row["local"]["md5"])
                ledger_dirty = True
                pushed += 1
                ok(f"pushed {label} ({human_size(row['local']['size'])})")
            except RcloneError as exc:
                warn(f"push failed {label}: {exc}")
                failures += 1

        # bootstrap rule: matching copies with no record are recorded, not pushed
        if not args.dry_run and record_bootstrap(ledger, rows):
            ledger_dirty = True
        if ledger_dirty:
            save_ledger(ledger)
        in_sync = sum(1 for r in rows if r["state"] == "in-sync")
        say(("dry-run: " if args.dry_run else "")
            + transfer_summary(pushed, 0, conflicts, in_sync, failures))
        return 1 if failures else 0


