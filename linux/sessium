    p_hook.add_argument("--off", action="store_true",
                        help="remove the sessium hook from settings.json")
    p_hook.add_argument("--print", action="store_true",
                        help="print the resulting settings.json, change nothing")
    p_hook.set_defaults(func=cmd_hook)

    p_export = sub.add_parser(
        "export", help="write sessions out as Markdown or a static HTML viewer")
    p_export.add_argument("session", metavar="ID", nargs="?", default=None,
                          help="session id (prefix ok); omit with --all")
    p_export.add_argument("--all", action="store_true",
                          help="export every local session")
    p_export.add_argument("--project", metavar="MUNGED", help="only this project folder")
    p_export.add_argument("--html", action="store_true",
                          help="HTML instead of Markdown (index.html with --all)")
    p_export.add_argument("--out", default="sessium-export", metavar="DIR",
                          help="output directory (default ./sessium-export)")
    p_export.set_defaults(func=cmd_export)

    p_onboard = sub.add_parser(
        "onboard", help="first-run report: what is set up, what to do next")
    p_onboard.set_defaults(func=cmd_onboard)

    return parser


ADOPT_FLAG_TOKENS = ("--dry-run", "-h", "--help")


def preprocess_argv(argv: list) -> list:
    """Munged path arguments always begin with '-' (e.g. -home-recoding-Kairo-v1),
    which argparse would mistake for a flag. Rewrite '--project -foo' into
    '--project=-foo', and for adopt hoist its known flags ahead of a '--'
    that shields the leading-dash source positional (everything after '--'
    would otherwise be gobbled as positionals)."""
    out = []
    i = 0
    while i < len(argv):
        if argv[i] == "--project" and i + 1 < len(argv):
            out.append(f"--project={argv[i + 1]}")
            i += 2
            continue
        if argv[i] == "adopt":
            flags, rest = [], []
            for tok in argv[i + 1:]:
                (flags if tok in ADOPT_FLAG_TOKENS else rest).append(tok)
            out.append("adopt")
            out.extend(flags)
            if rest and rest[0].startswith("-"):
                out.append("--")
            out.extend(rest)
            break
        out.append(argv[i])
        i += 1
    return out


def main(argv=None) -> int:
    global DEBUG, QUIET
    if argv is None:
        argv = sys.argv[1:]
    parser = build_parser()
    args = parser.parse_args(preprocess_argv(list(argv)))
    DEBUG = args.debug
    QUIET = getattr(args, "quiet", False)
    try:
        return args.func(args)
    except RcloneError as exc:
        fail(str(exc))
        return 1
    except LockBusy as exc:
        fail(str(exc))
        return 1
    except KeyboardInterrupt:
        say("")
        warn("interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
