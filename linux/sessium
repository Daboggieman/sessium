def want_interactive(args) -> bool:
    """Prompts on a terminal by default; --interactive forces them (tests,
    scripted runs with piped answers)."""
    return bool(args.interactive) or sys.stdin.isatty()


def ask_conflict(row: dict) -> str:
    """Interactive conflict prompt → 'local' | 'remote' | 'auto' | 'skip'.
    Empty answer = 'auto' (newest wins)."""
    local, remote = row["local"], row["remote"]
    say(f"\nCONFLICT {row['project']}/{short_id(row['id'])} — both copies "
        "changed since the last sync")
    say(f"  local   {fmt_time(mtime_of(local))}  {human_size(local['size'])}")
    say(f"  remote  {fmt_time(mtime_of(remote))}  {human_size(remote['size'])}")
    while True:
        try:
            ans = input("  [L]ocal / [R]emote / [B]oth (newest wins) / [S]kip? "
                        ).strip().lower()
        except EOFError:
            return "skip"
        if ans in ("l", "local"):
            return "local"
        if ans in ("r", "remote"):
            return "remote"
        if ans in ("b", "both", ""):
            return "auto"
        if ans in ("s", "skip"):
            return "skip"
        say("  answer l, r, b, or s")


def resolve_conflict(row: dict, interactive: bool) -> str:
    """'local' | 'remote' | 'auto' | 'skip'. With a prompt, the user picks;
    otherwise 'auto' — newest wins, tie goes to local (applied in one place,
    apply_conflict)."""
    if interactive:
        return ask_conflict(row)
    return "auto"


def describe_conflict(row: dict) -> str:
    """What apply_conflict's newest-wins default would do — for --dry-run,
    which shows the decision it would make without making it."""
    rt, lt = mtime_of(row["remote"]), mtime_of(row["local"])
    if rt is not None and (lt is None or rt > lt):
        return "remote wins (newer; local kept as revert)"
    return "local wins (newer; remote kept as revert)"


def apply_conflict(cfg: dict, row: dict, choice: str, ledger: dict) -> str:
    """Execute a conflict choice; the losing copy is always preserved — in
    revert/ (swap-back quarantine) and again in history/ (content-addressed
    timeline, SPEC §10). Returns a human label for the log line."""
    project, sid = row["project"], row["id"]
    local, remote = row["local"], row["remote"]
    if choice == "local":
        kept = save_remote_revert(cfg, project, sid)
        snapshot_history(project, sid, kept)
        upload_session(cfg, project, sid, local["path"])
        record_sync(ledger, project, sid, local["md5"], local["md5"])
        return "local wins"
    if choice == "remote":
        saved = save_local_revert(project, sid, Path(local["path"]))
        snapshot_history(project, sid, saved)
        download_session(cfg, project, sid, local["path"])
        record_sync(ledger, project, sid, remote["md5"], remote["md5"])
        return f"remote wins (local kept as {saved.name})"
    # 'auto' / 'both' — newest wins, tie goes to local
    rt, lt = mtime_of(remote), mtime_of(local)
    if rt is not None and (lt is None or rt > lt):
        saved = save_local_revert(project, sid, Path(local["path"]))
        snapshot_history(project, sid, saved)
        download_session(cfg, project, sid, local["path"])
        record_sync(ledger, project, sid, remote["md5"], remote["md5"])
        return f"remote wins (newer; local kept as {saved.name})"
    kept = save_remote_revert(cfg, project, sid)
    snapshot_history(project, sid, kept)
    upload_session(cfg, project, sid, local["path"])
    record_sync(ledger, project, sid, local["md5"], local["md5"])
    return "local wins (newer)"


def sync_only(cfg: dict, what: str, dry_run: bool) -> int:
    """Fast lane (--only memory / --only skills): two-way rclone copy
    --update of the small precious folders — per-file newest-wins, never
    deletes, no ledger (folder-level sync; sessions keep the md5 machine)."""
    claude = claude_dir()
    pairs = []                                    # (local_dir, drive_path)
    if what == "memory":
        root = claude / "projects"
        if root.is_dir():
            for project in sorted(root.iterdir()):
                mem = project / "memory"
                if project.is_dir() and mem.is_dir():
                    pairs.append((mem, drive_url(cfg, f"projects/{project.name}/memory")))
        try:
            proc = rclone("lsjson", "--recursive", drive_url(cfg, "projects"))
            entries = json.loads(proc.stdout or "[]")
        except RcloneError as exc:
            if "directory not found" in str(exc).lower():
                entries = []          # fresh remote — nothing to pull down yet
            else:
                fail(f"cannot reach Drive: {exc}")
                return 1
        except (json.JSONDecodeError) as exc:
            fail(f"cannot reach Drive: {exc}")
            return 1
        for entry in entries:
            m = re.match(r"projects/([^/]+)/memory/", entry.get("Path", ""))
            if not m:
                continue
            local_mem = root / m.group(1) / "memory"
            if not local_mem.is_dir():
                pairs.append((local_mem, drive_url(cfg, f"projects/{m.group(1)}/memory")))
    else:  # skills
        pairs.append((claude / "skills", drive_url(cfg, "config/skills")))

    if not pairs:
        say(f"nothing to sync for --only {what}")
        return 0
    transferred = 0
    failures = 0
    for local_dir, remote_dir in pairs:
        if dry_run:
            say(f"would two-way sync {local_dir}  <->  {remote_dir}")
            continue
        try:
            local_dir.mkdir(parents=True, exist_ok=True)
            rclone("copy", str(local_dir) + "/", remote_dir + "/", "--update",
                   timeout=300)
            rclone("copy", remote_dir + "/", str(local_dir) + "/", "--update",
                   timeout=300)
            transferred += 1
            ok(f"synced {what}: {local_dir.name}  <->  {remote_dir.split(':')[-1]}")
        except RcloneError as exc:
            warn(f"--only {what} failed for {local_dir}: {exc}")
            failures += 1
    if dry_run:
        say(f"dry-run: {len(pairs)} folder(s) would be synced — nothing changed")
    elif failures:
        say(transfer_summary(0, 0, 0, 0, failures))
    return 1 if failures else 0


def cmd_sync(args) -> int:
    """The workhorse: pull what changed there, push what changed here,
    resolve conflicts (newest wins automatically, prompts on a terminal)."""
    cfg = load_config()
    with transfer_lock(args.dry_run):
        if getattr(args, "only", None):
            return sync_only(cfg, args.only, args.dry_run)
        local_map = filter_map(local_sessions(), args.project)
        try:
            remote_map = filter_map(remote_sessions(cfg), args.project)
        except RcloneError as exc:
            fail(f"cannot reach Drive: {exc}")
            return 1
        ledger = load_ledger()
        rows = classify_ledger(local_map, remote_map, ledger)
        interactive = want_interactive(args) and not args.dry_run

        pushed = pulled = resolved = skipped = failures = 0
        ledger_dirty = False
        for row in rows:
            label = f"{row['project']}/{short_id(row['id'])}"
            state = row["state"]
            try:
                if state == "in-sync":
                    if args.dry_run:
                        continue
                    if not row["entry"]:        # bootstrap: record, no action
                        record_sync(ledger, row["project"], row["id"],
                                    row["local"]["md5"], row["remote"]["md5"])
                        ledger_dirty = True
                    continue
                if state in ("push", "new-here"):
                    if args.dry_run:
                        say(f"would push {label} "
                            f"({human_size(row['local']['size'])})")
                        pushed += 1
                        continue
                    upload_session(cfg, row["project"], row["id"],
                                   row["local"]["path"])
                    record_sync(ledger, row["project"], row["id"],
                                row["local"]["md5"], row["local"]["md5"])
                    ledger_dirty = True
                    pushed += 1
                    ok(f"pushed {label}")
                elif state in ("pull", "new-there"):
                    path = local_session_path(row["project"], row["id"])
                    if args.dry_run:
                        say(f"would pull {label} "
                            f"({human_size(row['remote']['size'])})")
                        pulled += 1
                        continue
                    download_session(cfg, row["project"], row["id"], str(path))
                    record_sync(ledger, row["project"], row["id"],
                                row["remote"]["md5"], row["remote"]["md5"])
                    ledger_dirty = True
                    pulled += 1
                    ok(f"pulled {label}")
                else:  # conflict
                    if args.dry_run:
                        say(f"would resolve {label}: {describe_conflict(row)}")
                        resolved += 1
                        continue
                    choice = resolve_conflict(row, interactive)
                    if choice == "skip":
                        skipped += 1
                        warn(f"skipped {label} — still diverged, run "
                             f"'sessium resolve {short_id(row['id'])}' later")
                        continue
                    outcome = apply_conflict(cfg, row, choice, ledger)
                    ledger_dirty = True
                    resolved += 1
                    ok(f"resolved {label}: {outcome}")
            except RcloneError as exc:
                warn(f"{state} failed {label}: {exc}")
                failures += 1

        if ledger_dirty:
            save_ledger(ledger)
        in_sync = sum(1 for r in rows if r["state"] == "in-sync")
        say(("dry-run: " if args.dry_run else "")
            + transfer_summary(pushed, pulled, 0, in_sync, failures)
            + (f"   resolved: {resolved}" if resolved else "")
            + (f"   skipped: {skipped}" if skipped else ""))
        return 1 if failures else 0


def transcript_messages(path: Path) -> list:
    """The conversation as (role, text) pairs — non-meta user/assistant
    lines, command/ide wrappers excluded. This is what --messages diffs."""
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") not in ("user", "assistant") or entry.get("isMeta"):
                    continue
                text = extract_text((entry.get("message") or {}).get("content")).strip()
                if not text or text.startswith(NOISE_PREFIXES):
                    continue
                out.append((entry["type"], " ".join(text.split())))
    except OSError:
        pass
    return out


def message_divergence(local_msgs: list, remote_msgs: list) -> dict:
    """Transcripts are append-mostly: the common prefix IS the last-synced
    content. Report what each side added past it."""
    common = 0
    for a, b in zip(local_msgs, remote_msgs):
        if a != b:
            break
        common += 1
    return {"common": common,
            "local_added": local_msgs[common:],
            "remote_added": remote_msgs[common:]}


def cmd_diff(args) -> int:
    """Side-by-side local vs remote vs last-synced for one session."""
    cfg = load_config()
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        fail(f"cannot reach Drive: {exc}")
        return 1
    row = find_one_session(args.session, local_sessions(), remote_map)
    if row is None:
        return 1
    project, sid = row["project"], row["id"]

    infos = {}
    tmp_remote = None
    try:
        for side in ("local", "remote"):
            sess = row[side]
            if not sess:
                infos[side] = {"messages": 0, "last": ""}
            elif side == "local":
                infos[side] = inspect_transcript(Path(sess["path"]))
            else:
                tmp_remote = fetch_remote_transcript(cfg, project, sid)
                infos[side] = inspect_transcript(tmp_remote)

        preview = None
        if getattr(args, "messages", False):
            if not row["local"] or not row["remote"]:
                warn("--messages needs both copies present (pull first if "
                     "the remote side is missing)")
            else:
                divergence = message_divergence(
                    transcript_messages(Path(row["local"]["path"])),
                    transcript_messages(tmp_remote))
                preview = divergence
    finally:
        if tmp_remote is not None:
            tmp_remote.unlink(missing_ok=True)

    if getattr(args, "json", False):
        entry = row["entry"]
        emit_json({
            "project": project,
            "id": sid,
            "state": row["state"],
            "local": None if not row["local"] else {
                "path": row["local"]["path"],
                "size": row["local"]["size"],
                "md5": row["local"].get("md5", ""),
                "mtime": iso_time(row["local"]["mtime"]),
                "messages": infos["local"]["messages"],
                "last": infos["local"]["last"],
            },
            "remote": None if not row["remote"] else {
                "size": row["remote"]["size"],
                "md5": row["remote"].get("md5", ""),
                "mtime": iso_time(row["remote"]["mtime"]),
                "messages": infos["remote"]["messages"],
                "last": infos["remote"]["last"],
            },
            "ledger": None if not entry else {
                "last_synced": entry.get("last_synced"),
                "local_md5": entry.get("local_md5"),
                "remote_md5": entry.get("remote_md5"),
            },
            **({"preview": preview} if preview is not None else {}),
        })
        return 0

    say(f"session {sid}")
    say(f"  project     {project}")
    say(f"  state       {fmt_state(row['state'])}")
    for side, sess in (("local", row["local"]), ("remote", row["remote"])):
        info = infos[side]
        if not sess:
            say(f"  {side:<9}  (absent)")
            continue
        say(f"  {side:<9}  {human_size(sess['size'])}  {fmt_time(mtime_of(sess))}"
            f"  {info['messages']} msgs")
        if info["last"]:
            say(f"            last: {info['last']}")
    if preview is not None:
        common = preview["common"]
        say(f"  conversation  common prefix: {common} message(s) — "
            "everything past it is unsynced")
        for who in ("local", "remote"):
            msgs = preview[f"{who}_added"]
            say(f"    {who} adds {len(msgs)}")
            for role, text in msgs[:12]:
                say(f"      + {role:<9} {text[:100]}")
            if len(msgs) > 12:
                say(f"      … {len(msgs) - 12} more")
    entry = row["entry"]
    if entry:
        say(f"  ledger      last synced {entry.get('last_synced', '?')}  "
            f"local_md5 {(entry.get('local_md5') or '')[:12]}  "
            f"remote_md5 {(entry.get('remote_md5') or '')[:12]}")
    else:
        say("  ledger      no record yet")
    return 0


def cmd_resolve(args) -> int:
    """Manually resolve one conflicted session: [L]ocal / [R]emote / [B]oth /
    [S]kip. The losing copy always lands in revert/."""
    cfg = load_config()
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        fail(f"cannot reach Drive: {exc}")
        return 1
    row = find_one_session(args.session, local_sessions(), remote_map)
    if row is None:
        return 1
    if row["state"] != "conflict":
        say(f"{row['project']}/{row['id']} is {fmt_state(row['state'])} — "
            "nothing to resolve")
        return 0
    choice = ask_conflict(row)
    if choice == "skip":
        warn("skipped — session left diverged")
        return 0
    ledger = load_ledger()
    outcome = apply_conflict(cfg, row, choice, ledger)
    save_ledger(ledger)
    ok(f"resolved {row['project']}/{short_id(row['id'])}: {outcome}")
    return 0


def cmd_revert(args) -> int:
    """List a session's revert copies and swap the chosen one back in.
    The copy being replaced is itself moved to revert/ first, so nothing
    is ever lost by reverting."""
    prefix = args.session
    found = []
    root = claude_dir() / "projects"
    if root.is_dir():
        for project in sorted(root.iterdir()):
            rdir = project / "revert"
            if not rdir.is_dir():
                continue
            for path in sorted(rdir.glob("*.revert-*.jsonl")):
                if path.name.startswith(prefix):
                    found.append((project.name, path))
    if not found:
        fail(f"no revert copies match {prefix!r}")
        return 1
    keys = sorted({(proj, path.name.split(".revert-")[0]) for proj, path in found})
    if len(keys) > 1:
        fail(f"ambiguous id prefix {prefix!r} — matches:")
        for proj, sid in keys:
            say(f"  {proj}/{sid}")
        return 1
    project, sid = keys[0]
    copies = [path for proj, path in found if proj == project]
    say(f"revert copies of {sid} ({project}):")
    for i, path in enumerate(copies, 1):
        say(f"  {i}. {path.name}  {human_size(path.stat().st_size)}  "
            f"{fmt_time(path.stat().st_mtime)}")
    if args.dry_run:
        say("dry-run: would prompt for which copy to restore — nothing changed")
        return 0
    try:
        raw = input("number to restore (or q to cancel): ").strip().lower()
    except EOFError:
        raw = "q"
    if raw in ("q", "quit", ""):
        say("cancelled — nothing changed")
        return 0
    if not raw.isdigit() or not (1 <= int(raw) <= len(copies)):
        fail(f"not a valid choice: {raw!r}")
        return 1
    chosen = copies[int(raw) - 1]
    target = local_session_path(project, sid)
    if target.exists():                       # preserve what it replaces
        save_local_revert(project, sid, target)
    target.parent.mkdir(parents=True, exist_ok=True)
    chosen.replace(target)
    ok(f"restored {chosen.name} → {target}")
    ledger = load_ledger()
    entry = ledger.get("sessions", {}).get(ledger_key(project, sid))
    if entry:
        # local copy changed on purpose; leave remote_md5 so next sync pushes
        entry["local_md5"] = md5_of(target)
        save_ledger(ledger)
        say("next: 'sessium sync' pushes the restored copy to Drive")
    return 0


def cmd_checkout(args) -> int:
    """Restore a content-addressed history snapshot (see `sessium log <id>`).
    The copy it displaces is snapshotted first, so checkout never loses
    bytes either."""
    cfg = load_config()
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        warn(f"cannot reach Drive right now: {exc} — searching locally only")
        remote_map = {}
    row = find_one_session(args.session, local_sessions(), remote_map)
    if row is None:
        return 1
    project, sid = row["project"], row["id"]
    hdir = history_dir(project, sid)
    snaps = sorted(hdir.glob("*.jsonl")) if hdir.is_dir() else []
    if not snaps:
        fail(f"no history for {short_id(sid)} — snapshots appear when a sync "
             "overwrites a copy that had unsynced changes")
        return 1
    chosen = None
    for path in snaps:
        if path.name.split("-", 1)[0].lstrip("0") == str(args.seq).lstrip("0"):
            chosen = path
            break
    if chosen is None:
        fail(f"no snapshot #{args.seq} for {short_id(sid)} — available:")
        for path in snaps:
            say(f"  {path.stem}  {human_size(path.stat().st_size)}")
        return 1
    if args.dry_run:
        say(f"dry-run: would restore {chosen.name} → {local_session_path(project, sid)}")
        return 0
    target = local_session_path(project, sid)
    if target.exists():                       # preserve what it replaces
        displaced = save_local_revert(project, sid, target)
        snapshot_history(project, sid, displaced)
    target.parent.mkdir(parents=True, exist_ok=True)
    chosen.replace(target)
    ok(f"restored {chosen.name} → {target}")
    ledger = load_ledger()
    entry = ledger.get("sessions", {}).get(ledger_key(project, sid))
    if entry:
        entry["local_md5"] = md5_of(target)   # local changed on purpose
        save_ledger(ledger)
        say("next: 'sessium sync' pushes the restored copy to Drive")
    return 0


def cmd_gc(args) -> int:
    """Prune revert/ + history/ copies beyond --keep N most recent per
    session (default 10). Canonical transcripts and the ledger are never
    touched. --dry-run lists what would go."""
    keep = args.keep
    root = claude_dir() / "projects"
    doomed = []
    if root.is_dir():
        for project in sorted(root.iterdir()):
            if not project.is_dir():
                continue
            groups = {}
            rdir = project / "revert"
            if rdir.is_dir():
                for path in rdir.glob("*.jsonl"):
                    sid = path.name.split(".revert-")[0]
                    groups.setdefault(sid, []).append(path)
            for sid_dir in sorted(project.iterdir()):
                hdir = sid_dir / "history"
                if sid_dir.is_dir() and hdir.is_dir():
                    for path in hdir.glob("*.jsonl"):
                        groups.setdefault(sid_dir.name, []).append(path)
            for sid, paths in sorted(groups.items()):
                paths.sort(key=lambda p: p.stat().st_mtime, reverse=True)
                for path in paths[keep:]:
                    doomed.append((project.name, sid, path))
    if not doomed:
        say("nothing to prune")
        return 0
    for project, sid, path in doomed:
        if args.dry_run:
            say(f"would prune {project}/{sid}: {path}")
        else:
            try:
                path.unlink()
                ok(f"pruned {project}/{sid}: {path.name}")
            except OSError as exc:
                warn(f"could not prune {path}: {exc}")
    if args.dry_run:
        say(f"dry-run: {len(doomed)} file(s) would be pruned — nothing changed")
    else:
        say(f"pruned {len(doomed)} file(s); kept {keep} most recent per session")
    return 0


def do_adopt(src: str, repo: str, dry_run: bool = False) -> int:
    """Copy a munged project folder's sessions under this machine's name for
    `repo`. Shared by `sessium adopt` and `sessium open --adopt`; with
    dry_run it prints what it would copy and touches nothing. Never deletes
    and never clobbers a different existing copy."""
    dest = munge(repo)
    root = claude_dir() / "projects"
    src_dir = root / src
    if not src_dir.is_dir():
        fail(f"no project folder {src!r} under {root}")
        if root.is_dir():
            say("available folders:")
            for p in sorted(root.iterdir()):
                if p.is_dir():
                    say(f"  {p.name}")
        return 1
    if src == dest:
        say(f"already matches this machine's path ({dest}) — nothing to do")
        return 0
    copied = already = 0
    for item in sorted(src_dir.iterdir()):
        if item.name == "revert":
            continue                          # machine-local quarantines
        target = root / dest / item.name
        if item.is_file() and item.suffix == ".jsonl":
            if target.exists():
                if md5_of(target) == md5_of(item):
                    already += 1
                else:
                    warn(f"kept both: {item.name} differs from the copy already "
                         f"at the destination")
                continue
            if dry_run:
                say(f"would copy {item.name}")
                copied += 1
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(item, target)
            copied += 1
        elif item.is_dir():
            if target.exists():
                warn(f"folder {item.name}/ already exists at the destination "
                     "— left as is")
                continue
            if dry_run:
                say(f"would copy folder {item.name}/")
                copied += 1
                continue
            shutil.copytree(item, target)
            copied += 1
    say(("dry-run: " if dry_run else "")
        + f"adopted {src} → {dest}: {copied} copied, {already} already present")
    if not dry_run:
        say(f"next: cd {repo} && claude --resume")
    return 0


def cmd_adopt(args) -> int:
    """Copy sessions pulled under another machine's munged project folder
    into this machine's, so `claude --resume` can see them. Never deletes
    and never clobbers a different existing copy."""
    return do_adopt(args.source,
                    os.path.abspath(os.path.expanduser(args.repo_path)),
                    args.dry_run)


CRYPT_NAME = "sessium-crypt"


def setup_encrypted() -> int:
    """Wrap the plain remote in an rclone crypt layer and point sessium at
    it. Drive-side data beyond this point is unreadable ciphertext — the
    password is generated here and shown exactly once."""
    try:
        proc = rclone("config", "file", timeout=30)
    except RcloneError as exc:
        fail(f"cannot run rclone: {exc}")
        return 1
    lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    if not lines:
        fail("cannot locate rclone.conf (`rclone config file` came back empty)")
        return 1
    conf_path = lines[-1]
    cfg = load_config()
    plain = f"{cfg['rclone_remote']}:{cfg['drive_folder']}"
    password = secrets.token_urlsafe(24)
    try:
        rclone("config", "create", CRYPT_NAME, "crypt", f"remote={plain}",
               f"password={password}", timeout=60)
    except RcloneError as exc:
        fail(f"rclone config create failed: {exc}")
        return 1
    new_cfg = dict(cfg)                       # keep seeker_url & friends
    new_cfg["rclone_remote"] = CRYPT_NAME
    new_cfg["drive_folder"] = ""              # crypt root == old plain root
    try:
        config_path().write_text(json.dumps(new_cfg, indent=2) + "\n",
                                 encoding="utf-8")
    except OSError as exc:
        fail(f"cannot write config: {exc}")
        return 1
    ok(f"crypt remote '{CRYPT_NAME}' created over {plain} (rclone.conf: {conf_path})")
    ok("sessium config switched to the crypt remote")
    say("")
    say("=" * 62)
    say("SAVE THIS PASSWORD — encrypted data is unrecoverable without it:")
    say(f"    {password}")
    say("=" * 62)
    say("")
    say("next: sessium push   (re-uploads everything as ciphertext; existing")
    say("plaintext copies stay on Drive until you delete them by hand)")
    return 0


def cmd_setup(args) -> int:
    """Delegate to the platform installer (setup-ubuntu.sh on Linux), or with
    --encrypted wrap the working Drive remote in an rclone crypt layer."""
    if getattr(args, "encrypted", False):
        return setup_encrypted()
    # repo layout first (linux/sessium sits one level down), then whatever
    # install.sh put on PATH (~/.local/bin/setup-ubuntu.sh)
    script = Path(__file__).resolve().parent.parent / "setup-ubuntu.sh"
    if not script.is_file():
        found = shutil.which("setup-ubuntu.sh")
        if not found:
            fail(f"setup script not found at {script} or on PATH")
            return 1
        script = Path(found)
    passthrough = ["--check-only"] if args.check_only else []
    result = subprocess.run(["bash", str(script), *passthrough])
    return result.returncode


def cmd_version(args) -> int:
    say(f"sessium {VERSION}")
    return 0


def script_path() -> str:
    """Absolute path of this CLI (works installed or straight from the repo)."""
    return str(Path(sys.argv[0]).resolve())


def systemd_dir() -> Path:
    """Where user unit files live (SESSIUM_SYSTEMD_DIR overrides, for tests)."""
    return Path(os.environ.get(
        "SESSIUM_SYSTEMD_DIR",
        str(Path.home() / ".config" / "systemd" / "user")))


SCHEDULE_SERVICE = """\
[Unit]
Description=sessium: sync Claude Code sessions to Drive

[Service]
Type=oneshot
ExecStart={sessium} sync
"""

SCHEDULE_TIMER = """\
[Unit]
Description=Run sessium sync periodically

[Timer]
OnBootSec=5min
OnUnitActiveSec={interval}min
Persistent=true

[Install]
WantedBy=timers.target
"""


def cmd_schedule(args) -> int:
    """Install (or with --off remove) a systemd user timer running
    `sessium sync` every --interval minutes (default 30). Without a terminal
    attached sync resolves conflicts newest-wins automatically."""
    if args.print:
        say(SCHEDULE_SERVICE.format(sessium=script_path()).rstrip())
        say("--- 8< ---")
        say(SCHEDULE_TIMER.format(interval=args.interval).rstrip())
        say("--- 8< ---")
        say(f"units: {systemd_dir()}/sessium.service, {systemd_dir()}/sessium.timer")
        say("next: systemctl --user daemon-reload && systemctl --user enable --now sessium.timer")
        return 0
    if shutil.which("systemctl") is None:
        fail("systemctl not found — scheduling needs systemd user units")
        return 1
    sdir = systemd_dir()
    sdir.mkdir(parents=True, exist_ok=True)
    if args.off:
        subprocess.run(["systemctl", "--user", "disable", "--now",
                        "sessium.timer"], check=False)
        for name in ("sessium.timer", "sessium.service"):
            (sdir / name).unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        ok("schedule removed (sessium.timer disabled, units deleted)")
        return 0
    (sdir / "sessium.service").write_text(
        SCHEDULE_SERVICE.format(sessium=script_path()), encoding="utf-8")
    (sdir / "sessium.timer").write_text(
        SCHEDULE_TIMER.format(interval=args.interval), encoding="utf-8")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "--user", "enable", "--now", "sessium.timer"],
                   check=False)
    ok(f"schedule installed: sessium.timer every {args.interval} minutes")
    say("check: systemctl --user list-timers sessium.timer")
    return 0


def cmd_hook(args) -> int:
    """Install (or with --off remove) a Claude Code Stop hook that runs
    `sessium push --quiet` after every session turn. Edits
    <claude-dir>/settings.json, leaving unrelated hooks alone."""
    settings_path = claude_dir() / "settings.json"
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8")) \
            if settings_path.is_file() else {}
    except (json.JSONDecodeError, OSError) as exc:
        fail(f"cannot read {settings_path}: {exc}")
        return 1
    command = f"{script_path()} push --quiet"

    def is_sessium_hook(entry: dict) -> bool:
        return "sessium push" in json.dumps(entry.get("hooks", []))

    stop = data.get("hooks", {}).get("Stop", [])
    stop = [e for e in stop if not is_sessium_hook(e)]
    if not args.off:
        stop.append({"matcher": "",
                     "hooks": [{"type": "command", "command": command}]})
    if stop:
        data.setdefault("hooks", {})["Stop"] = stop
    else:
        data.get("hooks", {}).pop("Stop", None)
        if data.get("hooks") == {}:
            data.pop("hooks", None)
    if args.print:
        say(f"would write {settings_path}:")
        print(json.dumps(data, indent=2, sort_keys=True))
        return 0
    try:
        settings_path.write_text(
            json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    except OSError as exc:
        fail(f"cannot write {settings_path}: {exc}")
        return 1
    if args.off:
        ok(f"hook removed from {settings_path}")
    else:
        ok(f"hook installed in {settings_path}")
        say(f"every session turn now ends with: {command}")
    return 0


