def render_markdown(project: str, sid: str, path: Path) -> str:
    title = session_title(path) or sid
    msgs = transcript_messages(path)
    lines = [f"# {title}", "",
             f"- project: `{project}`",
             f"- session: `{sid}`",
             f"- messages: {len(msgs)}",
             "", "---", ""]
    for role, text in msgs:
        lines += [f"## {role}", "", text, ""]
    return "\n".join(lines)


def render_session_html(project: str, sid: str, path: Path) -> str:
    title = session_title(path) or sid
    msgs = transcript_messages(path)
    parts = [f"<!doctype html><meta charset='utf-8'><title>{html_.escape(title)}</title>",
             f"<style>{EXPORT_CSS}</style>",
             f"<h1>{html_.escape(title)}</h1>",
             f"<p class='meta'>{html_.escape(project)} · {sid} · "
             f"{len(msgs)} message(s)</p>"]
    for role, text in msgs:
        parts.append(f"<div class='msg {role}'><div class='role'>{role}</div>"
                     f"{html_.escape(text)}</div>")
    return "\n".join(parts)


def render_index_html(items: list) -> str:
    lis = "\n".join(
        f"<li><a href='{html_.escape(it['file'])}'>"
        f"{html_.escape(it['title'] or it['id'])}</a> "
        f"<span class='meta'>{html_.escape(it['project'])}</span></li>"
        for it in items)
    return ("<!doctype html><meta charset='utf-8'><title>sessium sessions</title>"
            f"<style>{EXPORT_CSS}</style>"
            f"<h1>sessium sessions</h1><ul>{lis}</ul>")


def cmd_export(args) -> int:
    """Write sessions out as Markdown (default) or HTML. --all exports every
    local session and, with --html, adds an index.html viewer page."""
    out = Path(args.out).expanduser()
    local_map = filter_map(local_sessions(), args.project)
    if not getattr(args, "all", False):
        if not args.session:
            fail("give a session id, or --all for every local session")
            return 1
        cfg = load_config()
        try:
            remote_map = remote_sessions(cfg)
        except RcloneError:
            remote_map = {}
        row = find_one_session(args.session, local_map, remote_map)
        if row is None:
            return 1
        if row["local"] is None:
            fail("that session is on Drive only — pull first "
                 "(export works on local copies)")
            return 1
        local_map = {row["project"]: [row["local"]]}
    items = []
    count = 0
    for project, sessions in local_map.items():
        for s in sessions:
            src = Path(s["path"])
            ext = "html" if args.html else "md"
            fname = f"{s['id']}.{ext}"
            items.append({"project": project, "id": s["id"],
                          "title": session_title(src), "file": fname})
    if not items:
        say("no sessions to export")
        return 0
    out.mkdir(parents=True, exist_ok=True)
    for it in items:
        src = claude_dir() / "projects" / it["project"] / f"{it['id']}.jsonl"
        if not src.is_file():
            warn(f"skipped {it['id']} (local copy vanished)")
            continue
        text = (render_session_html(it["project"], it["id"], src) if args.html
                else render_markdown(it["project"], it["id"], src))
        (out / it["file"]).write_text(text, encoding="utf-8")
        count += 1
    if args.html and args.all:
        (out / "index.html").write_text(render_index_html(items), encoding="utf-8")
    say(f"exported {count} session(s) to {out.resolve()}"
        + ("  (+ index.html)" if args.html and args.all else ""))
    return 0


def cmd_onboard(args) -> int:
    """First-run report: what is set up, what is missing, what to run next.
    Non-fatal — every check prints a line and the worst gap decides the
    suggested next step."""
    say("sessium onboard — setup checklist\n")
    next_steps = []
    try:
        proc = rclone("version", timeout=15)
        version = proc.stdout.splitlines()[0] if proc.stdout else "unknown"
        ok(f"rclone present ({version})")
    except RcloneError as exc:
        fail(f"rclone: {exc}")
        next_steps.append(("install rclone", "sessium setup"))

    cfg = load_config()
    encrypted = cfg["rclone_remote"] == CRYPT_NAME
    if encrypted:
        ok(f"encryption: on ({CRYPT_NAME})")
    else:
        warn("encryption: off — Drive copies are plaintext "
             "(optional: sessium setup --encrypted)")

    try:
        rclone("lsd", f"{cfg['rclone_remote']}:", timeout=30)
        ok(f"Drive reachable (remote '{cfg['rclone_remote']}')")
    except RcloneError as exc:
        fail(f"Drive not reachable: {exc}")
        next_steps.append(("authorize rclone", "sessium setup"))

    projects = local_sessions()
    session_count = sum(len(v) for v in projects.values())
    if session_count:
        ok(f"local repo: {len(projects)} project(s), {session_count} session(s)")
    else:
        warn(f"no sessions found under {claude_dir() / 'projects'}")

    ledger_path = state_path()
    if ledger_path.is_file():
        try:
            n = len(json.loads(ledger_path.read_text(encoding="utf-8"))
                    .get("sessions", {}))
            ok(f"ledger: {n} session(s) recorded (has synced at least once)")
        except (json.JSONDecodeError, OSError):
            warn("ledger unreadable — it will rebuild on next sync")
    else:
        warn("ledger: empty — nothing synced yet "
             "(first: sessium push, then sessium sync)")

    timer = systemd_dir() / "sessium.timer"
    if timer.is_file():
        ok("sync timer: installed (sessium.timer)")
    else:
        warn("sync timer: not installed — sessium schedule (sync every 30 min)")
        next_steps.append(("background sync", "sessium schedule"))

    settings_path = claude_dir() / "settings.json"
    hooked = False
    try:
        if settings_path.is_file() \
                and "sessium push" in settings_path.read_text(encoding="utf-8"):
            hooked = True
    except OSError:
        pass
    if hooked:
        ok("Stop hook: installed (pushes after every session turn)")
    else:
        warn("Stop hook: not installed — sessium hook (auto-push per turn)")
        next_steps.append(("auto-push hook", "sessium hook"))

    say("")
    if next_steps:
        say("suggested next steps:")
        for what, cmd in next_steps:
            say(f"  {cmd:<24}  # {what}")
    else:
        say("all set. everyday commands: status / sync / search / open")
    say("help: sessium --help   man: man sessium")
    return 0


def cmd_open(args) -> int:
    """Print (or with --go, run) the resume command for a session. The repo
    path comes from the transcript's own `cwd` stamps, so this works across
    machines despite the lossy munging. --adopt rehomes the sessions first
    when the repo isn't at this machine's matching path."""
    cfg = load_config()
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        warn(f"cannot reach Drive right now: {exc} — searching locally only")
        remote_map = {}
    row = find_one_session(args.session, local_sessions(), remote_map)
    if row is None:
        return 1
    if not row["local"]:
        fail(f"{row['project']}/{row['id']} is not on this machine — "
             "run 'sessium pull' first")
        return 1
    cwd = session_cwd(Path(row["local"]["path"]))
    if not cwd:
        # lossy inverse of munge(), as a last resort — flagged as a guess
        proj = row["project"]
        cwd = ("/" + proj[1:].replace("-", "/")) if proj.startswith("-") \
            else proj.replace("-", "/")
        warn(f"transcript has no cwd stamp — guessing {cwd}")
    if args.adopt and not Path(cwd).is_dir():
        say(f"repo path {cwd} does not exist here — adopting sessions first")
        rc = do_adopt(row["project"], cwd, args.dry_run)
        if rc != 0:
            return rc
    resume = f"cd {cwd} && claude --resume {row['id']}"
    if args.go:
        return subprocess.run(resume, shell=True).returncode
    say(resume)
    return 0


def cmd_log(args) -> int:
    """No id: git-style alias for `list`. With an id: list the session's
    content-addressed history snapshots (taken whenever a sync overwrites a
    copy that had unsynced changes)."""
    if not args.session:
        return cmd_list(args)
    cfg = load_config()
    try:
        remote_map = remote_sessions(cfg)
    except RcloneError as exc:
        warn(f"cannot reach Drive right now: {exc} — searching locally only")
        remote_map = {}
    row = find_one_session(args.session, local_sessions(), remote_map)
    if row is None:
        return 1
    project, sid = row["project"], row["id"]
    hdir = claude_dir() / "projects" / project / sid / "history"
    snaps = sorted(hdir.glob("*.jsonl")) if hdir.is_dir() else []
    if not snaps:
        say(f"no history yet for {short_id(sid)} — snapshots appear here "
            "when a sync overwrites a copy that had unsynced changes")
        return 0
    say(f"history of {sid} ({project}):")
    for path in snaps:
        try:
            stat = path.stat()
        except OSError:
            continue
        say(f"  {path.stem}  {human_size(stat.st_size)}  "
            f"{fmt_time(stat.st_mtime)}")
    say(f"restore one with: sessium checkout {short_id(sid)} <seq>")
    return 0


# ---------------------------------------------------------------------------
# search — literal over local transcripts; semantic via seeker when configured
# ---------------------------------------------------------------------------

NOISE_PREFIXES = ("<command-", "<local-command", "<ide_")
DEFAULT_SEARCH_LIMIT = 20


def search_body(path: Path, query: str) -> str:
    """First jsonl-aware hit of query in a transcript's message text, as a
    ±snippet. Skips meta entries and command wrappers. One hit per file —
    a session matches once, its rank decides ordering."""
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") not in ("user", "assistant") or entry.get("isMeta"):
                    continue
                text = extract_text((entry.get("message") or {}).get("content")).strip()
                if not text or text.startswith(NOISE_PREFIXES):
                    continue
                if query in text.lower():
                    return snippet_around(text, query)
    except OSError:
        pass
    return ""


def snippet_around(text: str, query: str, width: int = 60) -> str:
    lowered = text.lower()
    idx = lowered.find(query)
    if idx < 0:
        return " ".join(text.split())[:width]
    start = max(0, idx - width // 2)
    end = min(len(text), start + width * 2)
    body = " ".join(text[start:end].split())
    return ("…" if start > 0 else "") + body + ("…" if end < len(text) else "")


def search_local(args) -> list:
    """Literal search over local transcripts. Title matches outrank body
    matches; Drive-only sessions need a pull first (documented)."""
    local_map = filter_map(local_sessions(), args.project)
    query = args.query.lower()
    hits = []
    for project, sessions in sorted(local_map.items()):
        for s in sorted(sessions, key=lambda x: x["mtime"], reverse=True):
            path = Path(s["path"])
            title = session_title(path)
            body_hit = ""
            if query in title.lower():
                where = "title"
            else:
                body_hit = search_body(path, query)
                where = "body" if body_hit else None
            if where is None:
                continue
            hits.append({
                "project": project,
                "id": s["id"],
                "title": title,
                "snippet": body_hit,
                "where": where,
                "mtime": iso_time(s["mtime"]),
            })
    # rank first (title beats body), newest first within a rank — the second
    # sort is stable, so it preserves the mtime order inside each rank
    hits.sort(key=lambda h: h["mtime"] or "", reverse=True)
    hits.sort(key=lambda h: 0 if h["where"] == "title" else 1)
    return hits


def seeker_request(cfg: dict, path: str, payload: dict) -> dict:
    """POST JSON to the self-hosted seeker engine (Tailscale-only,
    bearer-auth; contract in SPEC §5)."""
    headers = {"Content-Type": "application/json"}
    if cfg.get("seeker_token"):
        headers["Authorization"] = f"Bearer {cfg['seeker_token']}"
    req = urllib.request.Request(
        cfg["seeker_url"].rstrip("/") + path,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def seeker_not_configured() -> int:
    fail("seeker not configured — put \"seeker_url\" (and \"seeker_token\") "
         "in config.json; literal search works without it")
    return 1


def semantic_search(args, cfg: dict) -> list:
    """Query the seeker engine and map chunk hits back to session ids."""
    out = seeker_request(cfg, "/v1/search", {
        "query": args.query, "limit": args.limit, "source": "sessium"})
    hits = []
    for hit in out.get("results", out.get("hits", [])):
        if not isinstance(hit, dict):
            continue
        src = str(hit.get("path") or hit.get("source") or "")
        m = re.search(r"projects/([^/]+)/([^/]+)\.jsonl", src)
        if not m:
            continue
        hits.append({
            "project": m.group(1),
            "id": m.group(2),
            "title": " ".join(str(hit.get("title", "")).split())[:70],
            "snippet": " ".join(str(hit.get("text", "")).split())[:140],
            "where": "semantic",
            "mtime": None,
        })
    return hits


def print_search_hits(hits: list, limit: int) -> None:
    if not hits:
        say("no matches")
        return
    for h in hits[:limit]:
        stamp = h["mtime"] or "-"
        say(f"  {short_id(h['id'])}  {stamp}  {h['where']:<8}  {h['project']}")
        if h["title"]:
            say(f"      {h['title']}")
        if h["snippet"]:
            say(f"      {h['snippet']}")


def cmd_search(args) -> int:
    """Search sessions: literal (title > body) always; --semantic queries
    seeker when configured. Local transcripts only — pull first to include
    Drive-only sessions."""
    cfg = load_config()
    if args.semantic:
        if not cfg.get("seeker_url"):
            return seeker_not_configured()
        try:
            hits = semantic_search(args, cfg)
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as exc:
            fail(f"seeker unreachable at {cfg['seeker_url']}: {exc}")
            return 1
    else:
        hits = search_local(args)
    if getattr(args, "json", False):
        emit_json(hits[:args.limit])
        return 0
    say(f"search {args.query!r} — {len(hits)} match(es)"
        + ("  (local transcripts; pull first for Drive-only sessions)"
           if not args.semantic else "  (via seeker)"))
    print_search_hits(hits, args.limit)
    return 0


def cmd_seek(args) -> int:
    """Register/sync the local projects tree as a seeker source."""
    cfg = load_config()
    if not cfg.get("seeker_url"):
        return seeker_not_configured()
    source = str(claude_dir() / "projects")
    try:
        out = seeker_request(cfg, "/v1/sources",
                             {"name": args.name or "sessium", "path": source})
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as exc:
        fail(f"seeker unreachable at {cfg['seeker_url']}: {exc}")
        return 1
    ok(f"seeker source synced: {source}")
    if isinstance(out, dict) and out.get("status"):
        say(f"  seeker said: {out['status']}")
    return 0


