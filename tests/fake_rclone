#!/usr/bin/env python3
"""Fake rclone for sessium's test suite.

Emulates the handful of rclone subcommands sessium uses, backed by a plain
directory on disk (FAKE_DRIVE_ROOT) that mirrors the Drive folder layout:

    $FAKE_DRIVE_ROOT/<folder>/projects/<munged-path>/<session>.jsonl

Supported: version, lsd <remote>:, lsf <remote>:<path>, lsjson [--recursive]
[--hash] <remote>:<path>, copyto <src> <dst>, copy <src-dir> <dst-dir>
[--update], cat <remote>:<path>, deletefile <remote>:<path>, config file,
config create <name> <type> <key=val...> (logged to
$FAKE_DRIVE_ROOT/rclone-config.log). Everything else
exits 1 — deliberately, so tests catch sessium calling something new before
the stub learns it.
"""
import hashlib
import json
import os
import sys
from datetime import UTC, datetime
from pathlib import Path


def split_remote(arg: str) -> Path:
    """'gdrive:claude-backup/projects' -> $FAKE_DRIVE_ROOT/claude-backup/projects

    A leading slash after the colon is tolerated (real rclone allows it): with
    a crypt config, drive_folder is "" and drive_url emits '<remote>:/projects/...'.
    pathlib would treat that join as absolute and escape the fake drive, so
    strip it first."""
    if ":" not in arg:
        print(f"not a remote path: {arg}", file=sys.stderr)
        sys.exit(1)
    _, rest = arg.split(":", 1)
    return Path(os.environ["FAKE_DRIVE_ROOT"]) / rest.lstrip("/")


def resolve_arg(arg: str) -> Path:
    """Remote URL or local path? Rclone's own rule: a single character before
    the ':' is a Windows drive letter (C:\\Users\\...), not a remote name.
    Without this, every local path on Windows would be read inside the fake
    Drive and the smoke run could never pass."""
    if ":" in arg and len(arg.split(":", 1)[0]) > 1:
        return split_remote(arg)
    return Path(arg)


def list_dir_json(target: Path, recursive: bool, want_hash: bool) -> None:
    if not target.is_dir():
        print(f'directory not found: "{target}"', file=sys.stderr)
        sys.exit(1)
    entries = []
    if recursive:
        base = target
        for path in sorted(target.rglob("*")):
            rel = path.relative_to(base).as_posix()
            entries.append(entry(path, rel, want_hash))
    else:
        for path in sorted(target.iterdir()):
            entries.append(entry(path, path.name, want_hash))
    print(json.dumps(entries))


def entry(path: Path, display: str, want_hash: bool) -> dict:
    stat = path.stat()
    e = {
        "Path": display,
        "Name": path.name,
        "Size": stat.st_size if path.is_file() else 0,
        "MimeType": "inode/directory" if path.is_dir() else "application/octet-stream",
        "ModTime": datetime.fromtimestamp(stat.st_mtime, tz=UTC).strftime(
            "%Y-%m-%dT%H:%M:%S.%f000Z"          # ns precision, like real rclone
        ),
        "IsDir": path.is_dir(),
        "Hashes": {},
    }
    if want_hash and path.is_file():
        e["Hashes"]["MD5"] = hashlib.md5(path.read_bytes()).hexdigest()
    return e


def fail_inject(args: list) -> None:
    """SESSIUM_FAKE_FAIL_FIRST="<rc>,<count>" makes the first <count> copyto
    invocations exit <rc> with a plausible stderr line; later calls behave
    normally. The counter persists under the fake drive so it survives across
    processes — this is how the retry tests simulate a flaky uplink."""
    spec = os.environ.get("SESSIUM_FAKE_FAIL_FIRST", "")
    if not spec or not args or args[0] != "copyto":
        return
    rc_s, _, n_s = spec.partition(",")
    state = Path(os.environ["FAKE_DRIVE_ROOT"]) / "fake-fail-count"
    seen = int(state.read_text(encoding="utf-8")) if state.exists() else 0
    if seen < int(n_s):
        state.write_text(str(seen + 1), encoding="utf-8")
        print(f"fake_rclone: injected failure rc={rc_s} (attempt {seen + 1}/{n_s})",
              file=sys.stderr)
        sys.exit(int(rc_s))


def main() -> None:
    args = sys.argv[1:]
    if not args:
        sys.exit(1)
    fail_inject(args)
    if args[0] == "version":
        print("rclone vFAKE-STUB-1.0")
        return
    if args[0] == "config":
        if args[1] == "file":
            # real output ends with the config path; sessium takes the last line
            print("Configuration file is stored at:")
            print(f'{os.environ["FAKE_DRIVE_ROOT"]}/rclone.conf')
            return
        if args[1] == "create":
            rest = [a for a in args[2:] if not a.startswith("-")]
            log = Path(os.environ["FAKE_DRIVE_ROOT"]) / "rclone-config.log"
            with open(log, "a", encoding="utf-8") as handle:
                handle.write(" ".join(rest) + "\n")
            return
        print(f"fake_rclone: unsupported config subcommand: {args[1]}", file=sys.stderr)
        sys.exit(1)
    if args[0] == "lsd":
        target = split_remote(args[1])
        if target.exists():
            return
        print(f'directory not found: "{target}"', file=sys.stderr)
        sys.exit(1)
    if args[0] == "lsf":
        target = split_remote(args[1])
        if not target.is_dir():
            print(f'directory not found: "{target}"', file=sys.stderr)
            sys.exit(1)
        for child in sorted(target.iterdir()):
            suffix = "/" if child.is_dir() else ""
            print(child.name + suffix)
        return
    if args[0] == "lsjson":
        rest = args[1:]
        recursive = "--recursive" in rest
        want_hash = "--hash" in rest
        positional = [a for a in rest if not a.startswith("--")]
        list_dir_json(resolve_arg(positional[0]), recursive, want_hash)
        return
    if args[0] == "cat":
        target = resolve_arg(args[1])
        if not target.is_file():
            print(f"file not found: {target}", file=sys.stderr)
            sys.exit(1)
        sys.stdout.write(target.read_text(encoding="utf-8"))
        return
    if args[0] == "copyto":
        src, dst = args[1], args[2]
        src_path = resolve_arg(src)
        dst_path = resolve_arg(dst)
        if not src_path.is_file():
            print(f"file not found: {src_path}", file=sys.stderr)
            sys.exit(1)
        dst_path.parent.mkdir(parents=True, exist_ok=True)
        # a byte-for-byte copy keeps md5s consistent, like the real transport
        dst_path.write_bytes(src_path.read_bytes())
        return
    if args[0] == "copy":
        # recursive dir copy, like real rclone; --update skips files that are
        # newer on the destination (per-file newest-wins, what sync --only uses)
        update = "--update" in args
        positional = [a for a in args[1:] if not a.startswith("-")]
        src_dir = resolve_arg(positional[0])
        dst_dir = resolve_arg(positional[1])
        if not src_dir.is_dir():
            print(f"directory not found: {src_dir}", file=sys.stderr)
            sys.exit(1)
        for f in sorted(p for p in src_dir.rglob("*") if p.is_file()):
            target = dst_dir / f.relative_to(src_dir)
            if update and target.is_file() and target.stat().st_mtime > f.stat().st_mtime:
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(f.read_bytes())
        return
    if args[0] == "deletefile":
        target = resolve_arg(args[1])
        if not target.is_file():
            print(f"file not found: {target}", file=sys.stderr)
            sys.exit(3)
        target.unlink()
        return
    print(f"fake_rclone: unsupported command: {' '.join(args)}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
